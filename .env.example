# GOBOT CONFIGURATION (.env)

# Required: Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Optional: Default command prefix (Default: ,)
BOT_PREFIX=,

# Optional: Comma-separated list of Bot Owner Discord User IDs
BOT_OWNERS=123456789012345678,987654321098765432

# Optional: Custom binary path for ffmpeg (Default: external/ffmpeg.exe or ffmpeg)
FFMPEG_PATH=external/ffmpeg.exe

# Optional: Custom binary path for ffprobe (Default: external/ffprobe.exe or ffprobe)
FFPROBE_PATH=external/ffprobe.exe

# Optional: Custom binary path for yt-dlp (Default: external/yt-dlp.exe or yt-dlp)
YTDLP_PATH=external/yt-dlp.exe

# Optional: Path to cookies.txt file for yt-dlp to bypass YouTube rate limits
YTDLP_COOKIES_PATH=data/cookies.txt

# Optional: Logging verbosity (info, debug, warn, error - Default: info)
LOG_LEVEL=info

# Optional: Default embed color hex code (Default: 2B2D31)
DEFAULT_EMBED_COLOR=2B2D31

# Optional: Default radio player artwork URL
DEFAULT_RADIO_COVER_URL=

# Optional: Directory for cached radio songs (Default: data/cache/songs)
RADIO_CACHE_DIR=data/cache/songs

# Optional: Maximum giveaway duration cap (Default: 365d)
MAX_GIVEAWAY_DURATION=365d

# Optional: Maximum snipes stored per guild (Default: 1000)
MAX_SNIPE_LIMIT=1000

# Optional: Snipe expiration threshold in hours (Default: 24)
SNIPE_EXPIRATION_HOURS=24

# Optional: Juice WRLD API base URL (Default: https://juicewrldapi.com)
JUICEWRLD_API_URL=https://juicewrldapi.com

# Optional: Juice WRLD API request timeout (Default: 8s)
JUICEWRLD_API_TIMEOUT=8s

# Optional: Last.fm API Key for scrobble and profile commands
LASTFM_API_KEY=your_lastfm_api_key_here

# Optional: OCR Space API key for text recognition
OCR_SPACE_API_KEY=

# Optional: Storage.to API key for remote backups
STORAGE_TO_API_KEY=

# Optional: SQLite maximum concurrent open connections (Default: 10)
DB_MAX_OPEN_CONNS=10

# Optional: SQLite lock busy timeout in milliseconds (Default: 5000)
DB_BUSY_TIMEOUT=5000

# Optional: Enable automated database backup on startup (Default: true)
AUTO_BACKUP_ENABLED=true

# Optional: Minimum interval between database backups (Default: 24h)
AUTO_BACKUP_INTERVAL=24h

# Optional: Maximum number of backup files retained before deleting oldest (Default: 7)
BACKUP_RETENTION_COUNT=7

# Optional: Discord Webhook URL for console logs, errors, startup/shutdown alerts
CONSOLE_WEBHOOK_URL=

# Optional: Comma-separated list of globally banned Discord User IDs
GLOBAL_BLACKLISTED_USERS=

# Optional: Comma-separated list of pre-configured globally disabled commands
GLOBAL_DISABLED_COMMANDS=

# Optional: Custom HTTP User-Agent header for external requests
CUSTOM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/134.0.0.0 Safari/537.36 Edg/134.0.0.0

# Optional: Default rank card theme (dark, oled, glassmorphism, vibrant - Default: dark)
DEFAULT_RANK_CARD_THEME=dark

# Optional: Custom TTF font file path for image generation
CUSTOM_FONT_PATH=assets/fonts/Outfit.ttf

# Optional: Maximum media download size limit in MB for ripper (Default: 500)
MAX_MEDIA_DOWNLOAD_SIZE_MB=500

# Optional: Comma-separated extra allowed domains for media ripper
RIPPER_ALLOWED_DOMAINS=

# Optional: Temporary downloads directory path (Default: data/temp)
TEMP_DOWNLOAD_DIR=data/temp

# Optional: Data and database file paths
DATA_DIR=data
DATABASE_PATH=data/bot.db

# Optional: Register slash commands immediately to a specific guild ID
PRIMARY_GUILD_ID=

